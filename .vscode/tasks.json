{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start vite dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:.*http"
        }
      }
    },
    {
      "label": "rust: cargo build",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "kill vite",
      "type": "shell",
      "command": "taskkill /F /IM node.exe /T",
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    }
  ]
}
